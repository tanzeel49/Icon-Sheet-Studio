{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-desktop-write-recursive",
    "fs:allow-document-write-recursive",
    "fs:allow-download-write-recursive",
    "fs:allow-home-write-recursive",
    "fs:allow-write-file",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "updater:default",
    "process:default"
  ]
}
