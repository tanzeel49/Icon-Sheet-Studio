{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-desktop-write-recursive",
    "fs:allow-document-write-recursive",
    "fs:allow-download-write-recursive",
    "fs:allow-home-write-recursive",
    "fs:allow-write-file",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "updater:default",
    "process:default",
    "allow-write-file-native",
    "allow-save-project-native",
    "allow-load-project-native",
    "allow-list-checkpoints-native",
    "allow-restore-checkpoint-native",
    "allow-save-recovery-journal-native",
    "allow-clear-recovery-journal-native",
    "allow-check-recovery-native",
    "allow-create-backup-native",
    "allow-list-backups-native",
    "allow-restore-backup-native",
    "allow-get-storage-health-native",
    "allow-open-folder-native",
    "allow-get-yesterday-recovered-project",
    "allow-terminate-background-server"
  ]
}
