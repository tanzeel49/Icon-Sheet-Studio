{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Icon Sheet Studio",
  "version": "0.2.10",
  "identifier": "com.iconsheetstudio.desktop",
  "build": {
    "frontendDist": "../.next/standalone/Icon Sheet Studio/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": ""
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tanzeel49/Icon-Sheet-Studio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyN0FEODA5OTQ0NkIzRjQKUldUMHMwYVVDZGg2b25tdGoxRzdyS3B2Q0xxSjUzbkRaU3BqcmpRUHY5b0RJWWVyNG1pd2ljRmsK"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Icon Sheet Studio",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../.next/standalone"
    ],
    "externalBin": [
      "binaries/node"
    ]
  }
}
