{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Icon Sheet Studio",
  "version": "0.1.0",
  "identifier": "com.iconsheetstudio.desktop",
  "build": {
    "frontendDist": "../.next/standalone/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Icon Sheet Studio",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../.next/standalone"
    ],
    "externalBin": [
      "binaries/node"
    ]
  }
}
